{
  "name": "zunesync-ts",
  "version": "1.0.0",
  "description": "TypeScript library for reading and writing a Zune's ZMDB database and syncing music over MTPZ. Node via node-usb; browser via a pluggable transport.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "node --import tsx src/__tests__/validate.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "zune",
    "zmdb",
    "mtp",
    "mtpz",
    "zune-hd",
    "music",
    "podcast",
    "sync"
  ],
  "license": "MIT",
  "author": "brandonjames-dev@outlook.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandon-james-dev/zunesync-ts.git"
  },
  "bugs": {
    "url": "https://github.com/brandon-james-dev/zunesync-ts/issues"
  },
  "homepage": "https://github.com/brandon-james-dev/zunesync-ts#readme",
  "optionalDependencies": {
    "usb": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
